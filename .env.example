# Database (required -- docker compose refuses to start without DB_PASSWORD)
DB_USER=tpot
DB_PASSWORD=

# Only needed when running the backend outside docker compose (compose derives
# it from DB_USER/DB_PASSWORD). Put it in backend/.env or export it:
# DATABASE_URL=postgresql+asyncpg://tpot:<DB_PASSWORD>@localhost:5432/tpot_digest

# Dashboard auth (set these to protect your instance)
AUTH_USER=admin
AUTH_PASS=change_me_too

# Domain for HTTPS (Caddy auto-provisions Let's Encrypt certs)
DOMAIN=tpot.yourdomain.com

# Optional: AI API keys for topic clustering and embeddings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
